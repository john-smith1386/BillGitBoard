{
  "name": "BillGitBoard",
  "short_name": "BillGitBoard",
  "description": "Turn a GitHub-style contribution calendar screenshot into custom grid lettering.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#f7f7f2",
  "background_color": "#f5f6f1",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
