# FastAPI / container listener. Deployment platforms usually inject PORT.
PORT=8000

# Working storage for source images, analyzed grids, overlays, and renders.
# This relative value is for local Python. Compose overrides it with /data.
# A direct container accepts /data (or a child) or a child of /var/data; it
# refuses root, relative paths, and unrelated locations before chowning.
BILLGITBOARD_DATA_DIR=./data

# Parsed jobs and media expire after this many hours.
BILLGITBOARD_JOB_TTL_HOURS=24

# Upload and abuse controls. The hard product limit is 15 MB.
BILLGITBOARD_MAX_UPLOAD_MB=15
# Includes multipart framing and is enforced before UploadFile parsing. Keep it
# at least as large as MAX_UPLOAD_MB; one extra MB leaves framing headroom.
BILLGITBOARD_MAX_ANALYZE_BODY_MB=16
# Ceiling for JSON request bodies (render), enforced before the body is
# buffered or parsed. A valid render request is well under a kilobyte.
BILLGITBOARD_MAX_JSON_BODY_KB=64
# Reject decompression-bomb-sized images from their header before pixel decode.
BILLGITBOARD_MAX_IMAGE_PIXELS=16000000
# Bound expensive work globally in this process.
BILLGITBOARD_ANALYZE_CONCURRENCY=1
BILLGITBOARD_RENDER_CONCURRENCY=2
# Per-source-IP limits in the shared window below. Zero disables a limiter.
BILLGITBOARD_ANALYZE_RATE_LIMIT=20
BILLGITBOARD_RENDER_RATE_LIMIT=120
BILLGITBOARD_RATE_WINDOW_SECONDS=3600
# Deterministic repeats reuse a file; distinct render variants and total live
# artifacts remain bounded so a public service cannot fill its volume.
BILLGITBOARD_MAX_RENDER_VARIANTS_PER_JOB=20
BILLGITBOARD_JOB_STORE_MAX_MB=512

# Comma-separated browser origins, without trailing slashes. Leave empty for
# the recommended same-origin production build and the Vite development proxy.
# Example for a separately hosted UI:
# BILLGITBOARD_CORS_ORIGINS=https://overlay.example.com,https://admin.example.com
BILLGITBOARD_CORS_ORIGINS=

# The production container sets this to /app/frontend/dist. Set it manually
# only when running a locally built SPA through FastAPI.
# BILLGITBOARD_FRONTEND_DIR=frontend/dist

# Frontend development/build options. The proxy target is read by Vite during
# development; API_BASE_URL is embedded at build time and is normally blank so
# /api and /media stay same-origin.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Public origin the site is served from, used for the canonical link, Open
# Graph/Twitter preview URLs, and structured data. It is baked into index.html
# at build time, so rebuild the frontend after changing it. Point it at the
# origin that actually resolves: a canonical URL for a hostname that does not
# answer keeps the page out of search results.
VITE_SITE_URL=https://billgitboard.online

# Google Analytics measurement ID, compiled into index.html at build time.
# Analytics is off unless you set this. Put your own G-XXXXXXXXXX here, or on
# a managed platform set it in the service's environment so the value never
# lands in the repository. Blank means no tag is emitted at all: the script
# block is removed from the built HTML rather than loaded and disabled. The
# Vite dev server never injects it, so local work stays out of your property.
VITE_GA_MEASUREMENT_ID=

# Uvicorn proxy trust used by the Docker entrypoint. Keep the loopback default
# for a directly exposed container. Use * only behind a trusted platform load
# balancer that strips client-supplied forwarding headers.
FORWARDED_ALLOW_IPS=127.0.0.1

# Opt in to trusting one edge-set header as the true client address for
# rate limiting, e.g. cf-connecting-ip behind Cloudflare. Leave it EMPTY
# unless the proxy in front of this service overwrites that header on every
# request: anywhere it does not, a client can set it freely and each forged
# value receives its own rate-limit budget. Empty uses the peer address
# uvicorn resolved, which already honours FORWARDED_ALLOW_IPS.
BILLGITBOARD_CLIENT_IP_HEADER=
